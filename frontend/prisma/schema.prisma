// The single source of truth for every table. Change it, then run `npm run db:migrate:dev -- --name <change>`.
// The Python backend maps the same `folders` / `screenshots` tables with SQLAlchemy (backend/models.py).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Login (Better Auth). Field names follow Better Auth's schema. ---

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@map("verification")
}

// --- Reports. Written by the Python backend. ---

/// A named group of screenshots; charts and exports are per folder.
/// Names are unique ignoring case; the API checks that (Prisma can't express a lower(name) index).
model Folder {
  id          BigInt       @id @default(autoincrement())
  name        String       @unique(map: "folders_name_key")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  screenshots Screenshot[]

  @@map("folders")
}

/// One captured or uploaded image (stored in R2 under imageKey), or pasted report text, and its generated report.
model Screenshot {
  id        BigInt   @id @default(autoincrement())
  folderId  BigInt   @map("folder_id")
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  imageKey  String?  @map("image_key") // null for pasted text
  source    String // "upload" | "screen" | "text"
  text      String? // pasted report text, read instead of an image
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  fields    Json?
  report    String?
  error     String?

  @@index([folderId, createdAt], map: "screenshots_folder_created")
  @@map("screenshots")
}
